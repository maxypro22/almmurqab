# =============================================================================
# Al Murqab Law — Hostinger / Apache / LiteSpeed configuration
#
# Generated by `npm run build:static` from static-export/htaccess.
# Edit the template, not the copy in the upload folder.
#
# Replaces what Vercel and Next.js did at runtime:
#   - proxy.ts          -> language redirect for "/" and locale-less paths
#   - next.config.ts    -> 26 legacy redirects + security headers
#   - clean URLs        -> /ar/contact serves /ar/contact.html
# =============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

# /ar is both a page (ar.html) and a folder (ar/). Without this, Apache would
# redirect /ar to /ar/ before the clean-URL rule below could serve ar.html.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- 1. One host: https://almurqablaw.com ---------------------------------
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # --- 2. Old site URLs -> new pages (301) ----------------------------------
  # Protects the rankings of the 26 pages Google already has indexed.
  # Same map as redirects() in next.config.ts. Matched on THE_REQUEST so the
  # internal rewrite in step 5 (en/about -> en/about.html) can't re-trigger
  # them and loop.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ /ar [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+en/index\.html[\s?] [NC]
  RewriteRule ^ /en [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+about\.html[\s?] [NC]
  RewriteRule ^ /ar/about [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+en/about\.html[\s?] [NC]
  RewriteRule ^ /en/about [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+services\.html[\s?] [NC]
  RewriteRule ^ /ar/practice-areas [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+en/services\.html[\s?] [NC]
  RewriteRule ^ /en/practice-areas [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+contact\.html[\s?] [NC]
  RewriteRule ^ /ar/contact [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+en/contact\.html[\s?] [NC]
  RewriteRule ^ /en/contact [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+criminal\.html[\s?] [NC]
  RewriteRule ^ /ar/practice-areas/criminal [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+en/criminal\.html[\s?] [NC]
  RewriteRule ^ /en/practice-areas/criminal [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+civil\.html[\s?] [NC]
  RewriteRule ^ /ar/practice-areas/civil [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+en/civil\.html[\s?] [NC]
  RewriteRule ^ /en/practice-areas/civil [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+commercial\.html[\s?] [NC]
  RewriteRule ^ /ar/practice-areas/commercial [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+en/commercial\.html[\s?] [NC]
  RewriteRule ^ /en/practice-areas/commercial [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+corporate\.html[\s?] [NC]
  RewriteRule ^ /ar/practice-areas/corporate [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+en/corporate\.html[\s?] [NC]
  RewriteRule ^ /en/practice-areas/corporate [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+administrative\.html[\s?] [NC]
  RewriteRule ^ /ar/practice-areas/administrative [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+en/administrative\.html[\s?] [NC]
  RewriteRule ^ /en/practice-areas/administrative [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+realestate\.html[\s?] [NC]
  RewriteRule ^ /ar/practice-areas/real-estate [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+en/realestate\.html[\s?] [NC]
  RewriteRule ^ /en/practice-areas/real-estate [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+labor\.html[\s?] [NC]
  RewriteRule ^ /ar/practice-areas/labor [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+en/labor\.html[\s?] [NC]
  RewriteRule ^ /en/practice-areas/labor [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+family\.html[\s?] [NC]
  RewriteRule ^ /ar/practice-areas/family [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+en/family\.html[\s?] [NC]
  RewriteRule ^ /en/practice-areas/family [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+arbitration\.html[\s?] [NC]
  RewriteRule ^ /ar/practice-areas/arbitration [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+en/arbitration\.html[\s?] [NC]
  RewriteRule ^ /en/practice-areas/arbitration [R=301,L]

  # --- 3. One URL per page ---------------------------------------------------
  # /ar/contact.html -> /ar/contact  (only for what the visitor typed, so the
  # internal rewrite in step 5 cannot loop back into this rule)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteCond %1 !^404$
  RewriteRule ^ /%1 [R=301,L,NE]

  # /ar/contact/ -> /ar/contact
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # --- 4. No language in the URL -> Arabic (307, like proxy.ts) -------------
  # The firm asked for Arabic for every visitor, whatever the browser asks
  # for; the switch in the header covers everyone else.
  # Temporary on purpose: a 301 would pin a visitor to one language.
  # Anything with a file extension (images, robots.txt, sitemap.xml) is left
  # alone.
  # "/" gets its own rule so it lands on /ar in one hop, not via /ar/.
  RewriteRule ^$ /ar [R=307,L]

  RewriteCond %{REQUEST_URI} !^/(ar|en)(/|$)
  RewriteCond %{REQUEST_URI} !\.[a-z0-9]+$ [NC]
  RewriteRule ^(.+)$ /ar/$1 [R=307,L]

  # --- 5. Clean URLs: /ar/contact serves ar/contact.html --------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ /$1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Pages: always revalidate, so an upload shows up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # CSS and JS are referenced with ?v=<content hash>, and font files never
  # change, so they can be cached for a year.
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(jpe?g|png|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>
